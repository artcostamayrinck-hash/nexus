<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Nexus.Mobile.Converters"
             x:Class="Nexus.Mobile.Views.PanelPage"
             x:Name="PanelRootPage"
             Title="Painel"
             BackgroundColor="{Binding PanelBackgroundHex, Converter={StaticResource HexColorConverter}}">
  <ContentPage.Resources>
    <ResourceDictionary>
      <conv:HexToColorConverter x:Key="HexColorConverter" />
      <conv:HexToBrushConverter x:Key="HexBrushConverter" />
    </ResourceDictionary>
  </ContentPage.Resources>
  <ScrollView>
    <VerticalStackLayout Padding="18" Spacing="14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <VerticalStackLayout Spacing="2">
          <Label Text="Nexus Panel" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="{Binding ActiveProfileName, StringFormat='Perfil ativo: {0}'}" FontSize="13" TextColor="{Binding PanelAccentHex, Converter={StaticResource HexColorConverter}}" FontAttributes="Bold" />
        </VerticalStackLayout>
        <Button Grid.Column="1" Text="Editar" Command="{Binding ToggleEditModeCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="40" Padding="12,0" />
        <Button Grid.Column="2" Text="Atualizar" Command="{Binding RefreshLiveDataCommand}" Style="{StaticResource PrimaryButton}" HeightRequest="40" Padding="12,0" />
      </Grid>

      <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{Binding PanelAccentHex, Converter={StaticResource HexColorConverter}}" />

      <!-- Runtime Automation Indicators Banner -->
      <Border IsVisible="{Binding HasActiveIndicators}" BackgroundColor="#10243E" Stroke="{Binding PanelAccentHex, Converter={StaticResource HexBrushConverter}}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
        <VerticalStackLayout Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="INDICADORES DE AUTOMAÇÃO" FontSize="11" FontAttributes="Bold" TextColor="{Binding PanelAccentHex, Converter={StaticResource HexColorConverter}}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Limpar" Command="{Binding ClearIndicatorsCommand}" HeightRequest="30" Padding="10,0" FontSize="11" />
          </Grid>
          <CollectionView ItemsSource="{Binding ActiveIndicators}">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <VerticalStackLayout Margin="0,2">
                  <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                  <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </VerticalStackLayout>
      </Border>

      <!-- Profiles Switcher & Quick Controls -->
      <Border Style="{StaticResource NexusCard}">
        <VerticalStackLayout Spacing="8">
          <Label Text="PERFIS DE PAINEL (SALVAMENTO AUTOMÁTICO)" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
          <CollectionView ItemsSource="{Binding Profiles}" ItemsLayout="HorizontalList" HeightRequest="48">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <HorizontalStackLayout Spacing="6" Margin="0,0,8,0">
                  <Button Text="{Binding Name}"
                          Command="{Binding BindingContext.ActivateProfileCommand, Source={x:Reference PanelRootPage}}"
                          CommandParameter="{Binding .}"
                          Style="{StaticResource SecondaryButton}"
                          HeightRequest="38"
                          Padding="12,0" />
                  <Button Text="×"
                          IsVisible="{Binding BindingContext.IsEditMode, Source={x:Reference PanelRootPage}}"
                          Command="{Binding BindingContext.DeleteProfileCommand, Source={x:Reference PanelRootPage}}"
                          CommandParameter="{Binding .}"
                          BackgroundColor="#3B1219"
                          TextColor="#FCA5A5"
                          HeightRequest="38"
                          WidthRequest="38"
                          Padding="0" />
                </HorizontalStackLayout>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry Placeholder="Nome do novo perfil..." Text="{Binding NewProfileName}" Style="{StaticResource NexusEntry}" />
            <Button Grid.Column="1" Text="+ Perfil" Command="{Binding CreateProfileCommand}" Style="{StaticResource PrimaryButton}" HeightRequest="40" Padding="12,0" />
            <Button Grid.Column="2" Text="Sync PC" Command="{Binding SyncRemoteProfileCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="40" Padding="12,0" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Appearance & Add Widget Editor -->
      <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource NexusCard}" Stroke="{Binding PanelAccentHex, Converter={StaticResource HexBrushConverter}}">
        <VerticalStackLayout Spacing="10">
          <Label Text="PERSONALIZAÇÃO DE GRADE, TEMA E WIDGETS" FontSize="12" FontAttributes="Bold" TextColor="{Binding PanelAccentHex, Converter={StaticResource HexColorConverter}}" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Picker Title="Tema" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" TextColor="{StaticResource TextPrimary}" />
            <Picker Grid.Column="1" Title="Cor Destaque" ItemsSource="{Binding AvailableAccents}" SelectedItem="{Binding SelectedAccent}" TextColor="{StaticResource TextPrimary}" />
            <Picker Grid.Column="2" Title="Colunas" ItemsSource="{Binding AvailableGridColumnCounts}" SelectedItem="{Binding SelectedGridColumns}" TextColor="{StaticResource TextPrimary}" />
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Picker Title="Novo Widget" ItemsSource="{Binding AvailableWidgetTypes}" SelectedItem="{Binding SelectedWidgetToAdd}" TextColor="{StaticResource TextPrimary}" />
            <Picker Grid.Column="1" Title="Tamanho" ItemsSource="{Binding AvailableWidgetSizes}" SelectedItem="{Binding SelectedWidgetSize}" TextColor="{StaticResource TextPrimary}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="Título personalizado (opcional)" Text="{Binding NewWidgetTitle}" Style="{StaticResource NexusEntry}" />
            <Button Grid.Column="1" Text="+ Adicionar" Command="{Binding AddWidgetCommand}" Style="{StaticResource PrimaryButton}" HeightRequest="42" Padding="14,0" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Responsive Customizable Widget Grid -->
      <CollectionView ItemsSource="{Binding Widgets}">
        <CollectionView.ItemsLayout>
          <GridItemsLayout Orientation="Vertical"
                           Span="{Binding SelectedGridColumns}"
                           HorizontalItemSpacing="10"
                           VerticalItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Border BackgroundColor="{Binding CardBackgroundHex, Converter={StaticResource HexColorConverter}}"
                    Stroke="{Binding AccentHex, Converter={StaticResource HexBrushConverter}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="14">
              <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="{Binding AccentHex, Converter={StaticResource HexColorConverter}}" />
                  <Label Grid.Column="1" Text="{Binding SizeLabel}" FontSize="10" TextColor="{StaticResource TextMuted}" />
                </Grid>

                <Label Text="{Binding PrimaryValue}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" MaxLines="2" />
                <Label Text="{Binding SecondaryValue}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" MaxLines="2" />

                <!-- Inline interactive controls for interactive widget cards -->
                <HorizontalStackLayout IsVisible="{Binding IsVolumeWidget}" Spacing="6" Margin="0,4,0,0">
                  <Button Text="Vol -" Command="{Binding BindingContext.VolumeDownCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="10,0" FontSize="11" />
                  <Button Text="Mudo" Command="{Binding BindingContext.ToggleMuteCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="10,0" FontSize="11" />
                  <Button Text="Vol +" Command="{Binding BindingContext.VolumeUpCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="10,0" FontSize="11" />
                </HorizontalStackLayout>

                <HorizontalStackLayout IsVisible="{Binding IsMediaWidget}" Spacing="6" Margin="0,4,0,0">
                  <Button Text="⏮" Command="{Binding BindingContext.MediaPreviousCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="10,0" FontSize="12" />
                  <Button Text="⏯" Command="{Binding BindingContext.MediaPlayPauseCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="12,0" FontSize="12" />
                  <Button Text="⏭" Command="{Binding BindingContext.MediaNextCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="10,0" FontSize="12" />
                </HorizontalStackLayout>

                <HorizontalStackLayout IsVisible="{Binding IsQuickActionsWidget}" Spacing="6" Margin="0,4,0,0">
                  <Button Text="Win+D" Command="{Binding BindingContext.QuickHotkeyShowDesktopCommand, Source={x:Reference PanelRootPage}}" HeightRequest="34" Padding="10,0" FontSize="11" />
                </HorizontalStackLayout>

                <!-- Widget Edit-Mode Bar -->
                <Grid IsVisible="{Binding BindingContext.IsEditMode, Source={x:Reference PanelRootPage}}"
                      ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,6,0,0">
                  <Button Text="↑" Command="{Binding BindingContext.MoveWidgetUpCommand, Source={x:Reference PanelRootPage}}" CommandParameter="{Binding .}" HeightRequest="32" Padding="0" FontSize="12" />
                  <Button Grid.Column="1" Text="↓" Command="{Binding BindingContext.MoveWidgetDownCommand, Source={x:Reference PanelRootPage}}" CommandParameter="{Binding .}" HeightRequest="32" Padding="0" FontSize="12" />
                  <Button Grid.Column="2" Text="Tam." Command="{Binding BindingContext.CycleWidgetSizeCommand, Source={x:Reference PanelRootPage}}" CommandParameter="{Binding .}" HeightRequest="32" Padding="0" FontSize="10" />
                  <Button Grid.Column="3" Text="×" Command="{Binding BindingContext.RemoveWidgetCommand, Source={x:Reference PanelRootPage}}" CommandParameter="{Binding .}" BackgroundColor="#3B1219" TextColor="#FCA5A5" HeightRequest="32" Padding="0" FontSize="12" />
                </Grid>
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
