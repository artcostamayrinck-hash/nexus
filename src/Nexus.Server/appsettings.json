{
  "Urls": "http://127.0.0.1:5280",
  "Nexus": {
    "Storage": {
      "DatabaseFileName": "nexus-server.db"
    },
    "Tls": {
      "BindKestrelHttps": true,
      "HttpsPort": 5443,
      "RequireHttps": false
    },
    "Security": {
      "EnableLocalHostBridge": true
    },
    "Discovery": {
      "EnableMdns": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
