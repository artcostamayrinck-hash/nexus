<UserControl x:Class="Nexus.Desktop.Views.AutomationView"
             x:Name="AutomationRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Nexus Panel &amp; Nexus Automate" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Perfis personalizáveis de widgets, lista segura de atalhos Windows, regras de automação e histórico auditável."
                     Style="{StaticResource PageSubtitleStyle}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Kill Switch Emergência"
                  Command="{Binding ToggleKillSwitchCommand}"
                  Style="{StaticResource NexusDangerButtonStyle}"
                  Margin="0,0,8,0" />
          <Button Content="Motor Global"
                  Command="{Binding ToggleGlobalAutomationsCommand}"
                  Style="{StaticResource NexusSecondaryButtonStyle}"
                  Margin="0,0,8,0" />
          <Button Content="Atualizar"
                  Command="{Binding InitializeCommand}"
                  Style="{StaticResource NexusPrimaryButtonStyle}" />
        </StackPanel>
      </DockPanel>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource CyanAccentBrush}"
                 FontSize="12"
                 Margin="0,0,0,10" />

      <!-- Safety, Battery & Android Limitations Banner -->
      <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
        <StackPanel>
          <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding HostBatterySummary}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,18,0" />
            <TextBlock Text="{Binding IsKillSwitchActive, StringFormat='Kill Switch Ativo: {0}'}" Foreground="#FCA5A5" FontSize="13" FontWeight="Bold" Margin="0,0,18,0" />
            <TextBlock Text="{Binding IsGlobalAutomationsEnabled, StringFormat='Motor Global: {0}'}" Foreground="{StaticResource CyanAccentBrush}" FontSize="13" FontWeight="SemiBold" />
          </WrapPanel>
          <TextBlock Text="{Binding AndroidLimitationsNote}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Row 1: Panel Profiles/Widgets + Approved App Shortcuts -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel Profiles & Widget Organizer -->
        <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding ActiveProfileName, StringFormat='Nexus Panel — Perfil: {0}'}"
                         Style="{StaticResource CardHeaderStyle}"
                         DockPanel.Dock="Left" />
              <Button Content="Publicar no Servidor"
                      DockPanel.Dock="Right"
                      Command="{Binding SyncPanelRemoteCommand}"
                      Style="{StaticResource NexusSecondaryButtonStyle}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,0,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                    <Button Content="{Binding Name}"
                            Command="{Binding DataContext.ActivateProfileCommand, ElementName=AutomationRoot}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource NexusSecondaryButtonStyle}" />
                    <Button Content="×"
                            ToolTip="Excluir perfil de painel"
                            AutomationProperties.Name="Excluir perfil de painel"
                            Command="{Binding DataContext.DeleteProfileCommand, ElementName=AutomationRoot}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource NexusDangerButtonStyle}"
                            Margin="2,0,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource NexusTextBoxStyle}"
                       Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="Criar Perfil" Command="{Binding CreateProfileCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" />
            </Grid>

            <WrapPanel Margin="0,0,0,10">
              <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" Width="140" Margin="0,0,8,6" />
              <ComboBox ItemsSource="{Binding AvailableAccents}" SelectedItem="{Binding SelectedAccent}" Width="130" Margin="0,0,8,6" />
              <ComboBox ItemsSource="{Binding AvailableGridColumns}" SelectedItem="{Binding SelectedGridColumns}" Width="80" Margin="0,0,8,6" />
              <Button Content="Aplicar Aparência" Command="{Binding ApplyAppearanceCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" />
            </WrapPanel>

            <WrapPanel Margin="0,0,0,10">
              <ComboBox ItemsSource="{Binding AvailableWidgetTypes}" SelectedItem="{Binding SelectedWidgetToAdd}" Width="165" Margin="0,0,8,6" />
              <ComboBox ItemsSource="{Binding AvailableWidgetSizes}" SelectedItem="{Binding SelectedWidgetSize}" Width="130" Margin="0,0,8,6" />
              <Button Content="+ Widget" Command="{Binding AddWidgetCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" />
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding ActiveWidgets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource NavyDeepestBrush}"
                          BorderBrush="{StaticResource NavyBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="10,7"
                          Margin="0,0,0,6">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="↑" ToolTip="Mover widget para cima" AutomationProperties.Name="Mover widget para cima" Command="{Binding DataContext.MoveWidgetUpCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="↓" ToolTip="Mover widget para baixo" AutomationProperties.Name="Mover widget para baixo" Command="{Binding DataContext.MoveWidgetDownCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="Tam." ToolTip="Alternar tamanho do widget" AutomationProperties.Name="Alternar tamanho do widget" Command="{Binding DataContext.CycleWidgetSizeCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="×" ToolTip="Remover widget" AutomationProperties.Name="Remover widget" Command="{Binding DataContext.RemoveWidgetCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusDangerButtonStyle}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                          <Run Text="{Binding WidgetType, Mode=OneWay}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Size, Mode=OneWay}" />
                          <Run Text=" · (" />
                          <Run Text="{Binding GridRow, Mode=OneWay}" />
                          <Run Text="," />
                          <Run Text="{Binding GridColumn, Mode=OneWay}" />
                          <Run Text=")" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Allowlisted Approved Windows App Shortcuts -->
        <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <TextBlock Text="Atalhos de Aplicativos Aprovados (Allowlist)" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8" />
            <TextBlock Text="Somente atalhos listados aqui podem ser iniciados remotamente ou por automações."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <TextBlock Text="ID do Atalho (ex: vscode)" Style="{StaticResource LabelMutedStyle}" />
            <TextBox Text="{Binding NewShortcutId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,4,0,8" />

            <TextBlock Text="Nome Visível" Style="{StaticResource LabelMutedStyle}" />
            <TextBox Text="{Binding NewShortcutName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,4,0,8" />

            <TextBlock Text="Executável / Caminho Completo" Style="{StaticResource LabelMutedStyle}" />
            <TextBox Text="{Binding NewShortcutPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,4,0,8" />

            <CheckBox Content="Exigir confirmação prévia para iniciar"
                      IsChecked="{Binding NewShortcutRequireConfirmation}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,0,8" />

            <Button Content="Adicionar à Allowlist" Command="{Binding AddApprovedAppCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding ApprovedApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                    <DockPanel>
                      <Button Content="Remover"
                              DockPanel.Dock="Right"
                              Command="{Binding DataContext.RemoveApprovedAppCommand, ElementName=AutomationRoot}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource NexusDangerButtonStyle}" />
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding ExecutablePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 2: Rule Builder & Rules List + Execution History -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- Rule Editor -->
        <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <TextBlock Text="Editor de Regras (Gatilho → Condição → Ação)" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,10" />

            <TextBlock Text="Nome da Automação" Style="{StaticResource LabelMutedStyle}" />
            <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,4,0,8" />

            <WrapPanel Margin="0,0,0,8">
              <StackPanel Width="200" Margin="0,0,8,0">
                <TextBlock Text="Gatilho" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableTriggers}" SelectedItem="{Binding SelectedTrigger}" />
              </StackPanel>
              <StackPanel Width="200">
                <TextBlock Text="Ação" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableActionTypes}" SelectedItem="{Binding SelectedActionType}" />
              </StackPanel>
            </WrapPanel>

            <TextBlock Text="Perfil Alvo (para ActivatePanelProfile)" Style="{StaticResource LabelMutedStyle}" />
            <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTargetProfile}" Margin="0,4,0,8" />

            <TextBlock Text="Título / Mensagem (Indicador ou Notificação)" Style="{StaticResource LabelMutedStyle}" />
            <TextBox Text="{Binding ActionTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,4,0,6" />
            <TextBox Text="{Binding ActionMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,0,0,8" />

            <CheckBox Content="Condição: exigir conexão ativa" IsChecked="{Binding RequireConnectedCondition}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <CheckBox Content="Autorizar ações sensíveis nesta regra" IsChecked="{Binding AllowSensitiveExecution}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal">
              <Button Content="Salvar Automação" Command="{Binding SaveRuleCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" Margin="0,0,8,0" />
              <Button Content="Limpar" Command="{Binding ClearRuleEditorCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Rules List & Execution Audit History -->
        <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <TextBlock Text="Automações Configuradas &amp; Histórico" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,10" />

            <!-- Sensitive Confirmation Alert -->
            <Border Background="#3B1219" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPendingSensitivePrompt}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="{Binding PendingSensitivePrompt}" Foreground="#FEE2E2" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Autorizar Execução" Command="{Binding ConfirmSensitiveRuleCommand}" Style="{StaticResource NexusDangerButtonStyle}" Margin="0,0,8,0" />
                  <Button Content="Cancelar" Command="{Binding CancelSensitivePromptCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,0,0,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="At/Des" ToolTip="Ativar ou desativar regra" AutomationProperties.Name="Ativar ou desativar regra" Command="{Binding DataContext.ToggleRuleEnabledCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="Testar" Command="{Binding DataContext.TestRunRuleCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusPrimaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="Editar" Command="{Binding DataContext.EditRuleCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="Clonar" Command="{Binding DataContext.DuplicateRuleCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="×" ToolTip="Excluir regra de automação" AutomationProperties.Name="Excluir regra de automação" Command="{Binding DataContext.DeleteRuleCommand, ElementName=AutomationRoot}" CommandParameter="{Binding}" Style="{StaticResource NexusDangerButtonStyle}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Foreground="{StaticResource CyanAccentBrush}" FontSize="11">
                          <Run Text="{Binding Trigger, Mode=OneWay}" />
                          <Run Text=" · Ativa: " />
                          <Run Text="{Binding IsEnabled, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,4,0,8">
              <TextBlock Text="Histórico Auditável" Style="{StaticResource LabelMutedStyle}" DockPanel.Dock="Left" VerticalAlignment="Center" />
              <Button Content="Limpar Histórico" DockPanel.Dock="Right" Command="{Binding ClearHistoryCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding ExecutionHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding RuleName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Outcome}" Foreground="{StaticResource CyanAccentBrush}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" />
                      </DockPanel>
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

