<UserControl x:Class="Nexus.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,4,16">
      <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="Visão geral do núcleo local NEXUS, conectividade e integridade de armazenamento."
                 Style="{StaticResource PageSubtitleStyle}"
                 Margin="0,4,0,20" />

      <!-- Hero Summary Banner -->
      <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#122443" Offset="0" />
            <GradientStop Color="#0D1930" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="NÓ LOCAL ATIVO"
                       Foreground="{StaticResource CyanAccentBrush}"
                       FontSize="11"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding LocalDeviceName}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,4,0,2" />
            <TextBlock Text="{Binding PlatformBadge}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" />
            <TextBlock Text="{Binding LocalDeviceIdText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Content="Verificar Servidor"
                    AutomationProperties.Name="Verificar Servidor"
                    Command="{Binding ProbeServerCommand}"
                    Style="{StaticResource NexusPrimaryButtonStyle}"
                    Margin="0,0,10,0" />
            <Button Content="Atualizar"
                    AutomationProperties.Name="Atualizar Painel"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource NexusSecondaryButtonStyle}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- KPI Cards -->
      <UniformGrid Columns="3" Margin="0,0,0,16">
        <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="CONEXÃO COM SERVIDOR" Style="{StaticResource LabelMutedStyle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConnectionBadge}"
                       Foreground="{StaticResource CyanAccentBrush}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <TextBlock Text="{Binding ServerProbeDetail}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource NexusCardStyle}" Margin="5,0,5,0">
          <StackPanel>
            <TextBlock Text="DISPOSITIVOS CONHECIDOS" Style="{StaticResource LabelMutedStyle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RegisteredDevicesCount}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <TextBlock Text="Sincronizados no banco SQLite local"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource NexusCardStyle}" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Text="ARMAZENAMENTO &amp; NÚCLEO" Style="{StaticResource LabelMutedStyle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StorageHealthBadge}"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Route & VPN Connectivity Card -->
      <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,0,0,16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="CONECTIVIDADE ATIVA (LOCAL / TAILSCALE)" Style="{StaticResource LabelMutedStyle}" />
            <TextBlock Text="{Binding RouteSummary}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,2" />
            <TextBlock Text="{Binding VpnSummary}" Foreground="{StaticResource CyanAccentBrush}" FontSize="12" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Right"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     Text="Use a aba Conectividade para gerenciar LAN, mDNS e Tailscale."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12" />
        </DockPanel>
      </Border>

      <!-- Recent Activity & Event Bus Test -->
      <Border Style="{StaticResource NexusCardStyle}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <TextBlock Text="Eventos Recentes do Núcleo" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
            <Button Content="Disparar Evento de Teste"
                    AutomationProperties.Name="Disparar Evento de Teste"
                    Command="{Binding EmitDiagnosticEventCommand}"
                    Style="{StaticResource NexusSecondaryButtonStyle}"
                    HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding RecentActivities}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource NavyDeepestBrush}"
                        BorderBrush="{StaticResource NavyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,6">
                  <TextBlock Text="{Binding}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontFamily="Consolas"
                             FontSize="12" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <!-- Quick Access Integration Modules Card -->
      <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,16,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Vol -" Command="{Binding QuickVolumeDownCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,6,0" />
            <Button Content="Play/Pause" Command="{Binding QuickMediaPlayPauseCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,6,0" />
            <Button Content="Vol +" Command="{Binding QuickVolumeUpCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,10,0" />
            <Button Content="Painel &amp; Automações" Command="{Binding OpenAutomationCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,8,0" />
            <Button Content="Abrir Módulos" Command="{Binding OpenModulesCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Acesso Rápido · Control · Notify · Monitor · Media" Style="{StaticResource LabelMutedStyle}" />
            <TextBlock Text="{Binding QuickModulesBadge}" Foreground="{StaticResource CyanAccentBrush}" FontSize="15" FontWeight="Bold" Margin="0,3,0,2" />
            <TextBlock Text="{Binding QuickHostTelemetryText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
            <TextBlock Text="{Binding QuickMediaSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

