<UserControl x:Class="Nexus.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,4,16">
      <TextBlock Text="Configurações" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="Preferências locais persistidas automaticamente no banco SQLite da estação Windows."
                 Style="{StaticResource PageSubtitleStyle}"
                 Margin="0,4,0,20" />

      <Border Style="{StaticResource NexusCardStyle}">
        <StackPanel>
          <TextBlock Text="Identidade &amp; Conectividade" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,14" />

          <TextBlock Text="Nome de Exibição do Dispositivo" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
          <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Nome de Exibição do Dispositivo"
                   Style="{StaticResource NexusTextBoxStyle}"
                   Margin="0,0,0,14" />

          <TextBlock Text="Endpoint do Nexus.Server" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
          <TextBox Text="{Binding ServerEndpoint, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Endpoint do Servidor NEXUS"
                   Style="{StaticResource NexusTextBoxStyle}"
                   Margin="0,0,0,14" />

          <TextBlock Text="Nível Mínimo de Logs (Serilog)" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
          <ComboBox ItemsSource="{Binding LogLevels}"
                    SelectedItem="{Binding SelectedLogLevel}"
                    AutomationProperties.Name="Nível Mínimo de Logs"
                    Width="220"
                    HorizontalAlignment="Left"
                    Padding="10,8"
                    Margin="0,0,0,16" />

          <CheckBox Content="Verificar servidor automaticamente ao abrir o aplicativo"
                    IsChecked="{Binding AutoProbeServer}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="0,0,0,10" />

          <CheckBox Content="Habilitar animações discretas de interface"
                    IsChecked="{Binding EnableSubtleAnimations}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="0,0,0,20" />

          <StackPanel Orientation="Horizontal">
            <Button Content="Salvar Preferências"
                    AutomationProperties.Name="Salvar Preferências"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource NexusPrimaryButtonStyle}"
                    Margin="0,0,10,0" />
            <Button Content="Restaurar Padrões"
                    AutomationProperties.Name="Restaurar Padrões"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource NexusSecondaryButtonStyle}" />
          </StackPanel>

          <TextBlock Text="{Binding FeedbackMessage}"
                     Foreground="{StaticResource CyanAccentBrush}"
                     FontSize="12"
                     Margin="0,14,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource NexusCardStyle}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="NEXUS Update &amp; GitHub Releases" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding AppVersionDisplay, StringFormat='Versão local instalada: {0}'}"
                     Foreground="{StaticResource CyanAccentBrush}"
                     FontSize="12"
                     Margin="0,0,0,12" />

          <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Proprietário GitHub" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
              <TextBox Text="{Binding UpdateRepositoryOwner, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Proprietário GitHub"
                       Style="{StaticResource NexusTextBoxStyle}" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Repositório GitHub" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
              <TextBox Text="{Binding UpdateRepositoryName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Repositório GitHub"
                       Style="{StaticResource NexusTextBoxStyle}" />
            </StackPanel>
          </UniformGrid>

          <Button Content="Verificar GitHub Releases (HTTPS)"
                  AutomationProperties.Name="Verificar GitHub Releases"
                  Command="{Binding CheckUpdatesCommand}"
                  HorizontalAlignment="Left"
                  Style="{StaticResource NexusSecondaryButtonStyle}" />

          <TextBlock Text="{Binding UpdateCheckStatusText}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

