<UserControl x:Class="Nexus.Desktop.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Módulos de Integração NEXUS" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Controle remoto, encaminhamento de notificações Android, monitor real de hardware e mídia nativa Windows."
                     Style="{StaticResource PageSubtitleStyle}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Atualizar Hardware"
                  Command="{Binding RefreshMonitorCommand}"
                  Style="{StaticResource NexusSecondaryButtonStyle}"
                  Margin="0,0,8,0" />
          <Button Content="Atualizar Tudo"
                  Command="{Binding RefreshAllCommand}"
                  Style="{StaticResource NexusPrimaryButtonStyle}" />
        </StackPanel>
      </DockPanel>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource CyanAccentBrush}"
                 FontSize="12"
                 Margin="0,0,0,12" />

      <!-- Module Overview & Independent Status Cards -->
      <ItemsControl ItemsSource="{Binding ModuleStatuses}" Margin="0,0,0,14">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,10,10">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="{Binding Availability}" Foreground="{StaticResource CyanAccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2" />
                <TextBlock Text="{Binding RequiredPermission, StringFormat='Permissão: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Row 1: Nexus Media + Nexus Control -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Nexus Media Card -->
        <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Nexus Media (Controles Nativos &amp; Áudio)" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
              <CheckBox Content="Ativo"
                        DockPanel.Dock="Right"
                        IsChecked="{Binding IsMediaEnabled}"
                        Command="{Binding ToggleMediaCommand}"
                        Foreground="{StaticResource TextPrimaryBrush}" />
            </DockPanel>

            <TextBlock Text="{Binding MediaPlaybackBadge, StringFormat='Estado: {0}'}" Foreground="{StaticResource CyanAccentBrush}" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{Binding MediaTrackText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,2" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MediaMetadataNote}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

            <WrapPanel Margin="0,0,0,10">
              <Button Content="Anterior" Command="{Binding MediaPreviousCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,6,6" />
              <Button Content="Play / Pause" Command="{Binding MediaPlayPauseCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" Margin="0,0,6,6" />
              <Button Content="Próxima" Command="{Binding MediaNextCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,6,6" />
              <Button Content="Stop" Command="{Binding MediaStopCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,6,6" />
            </WrapPanel>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                  <Run Text="Volume Master: " />
                  <Run Text="{Binding MediaVolumeText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                  <Run Text=" · " />
                  <Run Text="{Binding MediaMuteBadge, Mode=OneWay}" Foreground="{StaticResource CyanAccentBrush}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="100" Value="{Binding TargetVolumePercent}" Margin="0,6,12,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Vol -" Command="{Binding VolumeDownCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                <Button Content="Vol +" Command="{Binding VolumeUpCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                <Button Content="Mudo" Command="{Binding ToggleMuteCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,4,0" />
                <Button Content="Aplicar" Command="{Binding ApplyVolumeCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Nexus Control Card -->
        <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Nexus Control (Controle Remoto &amp; Atalhos)" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
              <CheckBox Content="Ativo"
                        DockPanel.Dock="Right"
                        IsChecked="{Binding IsControlEnabled}"
                        Command="{Binding ToggleControlCommand}"
                        Foreground="{StaticResource TextPrimaryBrush}" />
            </DockPanel>

            <CheckBox Content="Exigir confirmação explícita para Bloquear / Suspender / Desligar"
                      IsChecked="{Binding RequirePowerConfirmation}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,0,6" />
            <CheckBox Content="Permitir ações de energia remotas neste host Windows"
                      IsChecked="{Binding AllowPowerActions}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,0,10" />

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding NewHotkeyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,0,6,0" ToolTip="Nome do atalho" />
              <TextBox Grid.Column="1" Text="{Binding NewHotkeyKeys, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,0,6,0" ToolTip="Teclas (ex.: Ctrl+Alt+T)" />
              <Button Grid.Column="2" Content="+ Atalho" Command="{Binding AddHotkeyCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" />
            </Grid>

            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding ControlFeedback}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Content="Salvar Control" Command="{Binding SaveControlSettingsCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" DockPanel.Dock="Right" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Hotkeys}" MaxHeight="150">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Executar"
                                Command="{Binding DataContext.ExecuteHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource NexusSecondaryButtonStyle}"
                                Padding="8,4"
                                Margin="0,0,4,0" />
                        <Button Content="✕"
                                Command="{Binding DataContext.RemoveHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource NexusDangerButtonStyle}"
                                Padding="8,4" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding HotkeyId, StringFormat='ID: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 2: Nexus Monitor -->
      <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Nexus Monitor (Telemetria Real de Hardware &amp; Sistema)" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
            <CheckBox Content="Monitor Ativo"
                      DockPanel.Dock="Right"
                      IsChecked="{Binding IsMonitorEnabled}"
                      Command="{Binding ToggleMonitorCommand}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
          </DockPanel>

          <UniformGrid Columns="4" Margin="0,0,0,12">
            <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="CPU" Style="{StaticResource LabelMutedStyle}" />
                <TextBlock Text="{Binding CpuUsageText}" Foreground="{StaticResource CyanAccentBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding CpuNameText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource LabelMutedStyle}" />
                <TextBlock Text="{Binding MemorySummaryText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding UptimeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="GPU (HARDWARE)" Style="{StaticResource LabelMutedStyle}" />
                <TextBlock Text="{Binding GpuSummaryText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding GpuAvailabilityNote}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock Text="TEMPERATURA" Style="{StaticResource LabelMutedStyle}" />
                <TextBlock Text="{Binding TemperatureSummaryText}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding TemperatureStatusNote}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Discos &amp; Armazenamento" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
                      <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                        <Run Text="{Binding DriveName}" FontWeight="SemiBold" />
                        <Run Text=" (" />
                        <Run Text="{Binding FileSystem}" />
                        <Run Text=") · " />
                        <Run Text="{Binding UsedPercent, StringFormat='{}{0:F1}% usado'}" Foreground="{StaticResource CyanAccentBrush}" />
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="Interfaces de Rede Ativas" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding NetworkInterfaces}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
                      <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                        <Run Text=" · " />
                        <Run Text="{Binding LinkSpeedMbps, StringFormat='{}{0:F0} Mbps'}" Foreground="{StaticResource CyanAccentBrush}" />
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="4">
              <TextBlock Text="Top Processos (RAM)" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding TopProcesses}" MaxHeight="135">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource NavyDeepestBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,0,4">
                      <DockPanel>
                        <TextBlock Text="{Binding WorkingSetMb, StringFormat='{}{0:F1} MB'}" Foreground="{StaticResource CyanAccentBrush}" FontSize="11" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Row 3: Nexus Notify -->
      <Border Style="{StaticResource NexusCardStyle}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Nexus Notify (Notificações Android no Windows)" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
            <CheckBox Content="Encaminhamento Ativo"
                      DockPanel.Dock="Right"
                      IsChecked="{Binding IsNotifyEnabled}"
                      Command="{Binding ToggleNotifyCommand}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
          </DockPanel>

          <TextBlock Text="{Binding AndroidNotifyNote}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding NotifyFilterModes}" SelectedItem="{Binding NotifyFilterMode}" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding AllowedAppsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,0,8,0" ToolTip="Apps permitidos (separados por vírgula)" />
            <TextBox Grid.Column="2" Text="{Binding BlockedAppsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,0,8,0" ToolTip="Apps bloqueados (separados por vírgula)" />
            <Button Grid.Column="3" Content="Salvar Filtros" Command="{Binding SaveNotifySettingsCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" Margin="0,0,6,0" />
            <Button Grid.Column="4" Content="Limpar Histórico" Command="{Binding ClearNotificationsCommand}" Style="{StaticResource NexusDangerButtonStyle}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding NotificationFeed}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource NavyDeepestBrush}" BorderBrush="{StaticResource NavyBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Dispensar"
                            Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource NexusSecondaryButtonStyle}"
                            VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock FontSize="12" Foreground="{StaticResource CyanAccentBrush}" FontWeight="SemiBold">
                        <Run Text="{Binding AppName}" />
                        <Run Text=" · " />
                        <Run Text="{Binding ReceivedAtUtc.LocalDateTime, StringFormat='HH:mm:ss'}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,2" />
                      <TextBlock Text="{Binding Body}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

