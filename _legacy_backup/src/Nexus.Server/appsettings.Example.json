{
  "Urls": "http://127.0.0.1:5280",
  "Nexus": {
    "Storage": {
      "DatabaseFileName": "nexus-server.db"
    },
    "Tls": {
      "BindKestrelHttps": true,
      "HttpsPort": 5443,
      "RequireHttps": false
    },
    "Security": {
      "EnableLocalHostBridge": true
    },
    "Discovery": {
      "EnableMdns": true
    },
    "Updates": {
      "RepositoryOwner": "seu-usuario-ou-org",
      "RepositoryName": "nexus-ecosystem",
      "GitHubApiBaseUrl": "https://api.github.com",
      "TokenEnvironmentVariable": "NEXUS_GITHUB_RELEASE_TOKEN",
      "IncludePrereleases": false,
      "ExpectedPackageId": "com.nexus.ecosystem",
      "ExpectedSignerSha256": "",
      "MinimumCompatibleServerVersion": "1.0.0",
      "MetadataCacheSeconds": 120
    }
  }
}

