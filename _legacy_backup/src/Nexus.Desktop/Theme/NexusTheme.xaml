<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- NEXUS Dark Navy & Cyan Design Tokens -->
  <Color x:Key="NavyDeepestColor">#070D1A</Color>
  <Color x:Key="NavyBaseColor">#0B1426</Color>
  <Color x:Key="NavySurfaceColor">#111E36</Color>
  <Color x:Key="NavyElevatedColor">#162744</Color>
  <Color x:Key="NavyBorderColor">#1F375E</Color>
  <Color x:Key="CyanAccentColor">#00E5FF</Color>
  <Color x:Key="CyanSoftColor">#0891B2</Color>
  <Color x:Key="BlueAccentColor">#3B82F6</Color>
  <Color x:Key="BluePressedColor">#2563EB</Color>
  <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
  <Color x:Key="TextSecondaryColor">#94A3B8</Color>
  <Color x:Key="TextMutedColor">#64748B</Color>
  <Color x:Key="SuccessColor">#10B981</Color>
  <Color x:Key="WarningColor">#F59E0B</Color>
  <Color x:Key="DangerColor">#EF4444</Color>

  <SolidColorBrush x:Key="NavyDeepestBrush" Color="{StaticResource NavyDeepestColor}" />
  <SolidColorBrush x:Key="NavyBaseBrush" Color="{StaticResource NavyBaseColor}" />
  <SolidColorBrush x:Key="NavySurfaceBrush" Color="{StaticResource NavySurfaceColor}" />
  <SolidColorBrush x:Key="NavyElevatedBrush" Color="{StaticResource NavyElevatedColor}" />
  <SolidColorBrush x:Key="NavyBorderBrush" Color="{StaticResource NavyBorderColor}" />
  <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccentColor}" />
  <SolidColorBrush x:Key="CyanSoftBrush" Color="{StaticResource CyanSoftColor}" />
  <SolidColorBrush x:Key="BlueAccentBrush" Color="{StaticResource BlueAccentColor}" />
  <SolidColorBrush x:Key="BluePressedBrush" Color="{StaticResource BluePressedColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

  <!-- Subtle Card Style -->
  <Style x:Key="NexusCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NavySurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NavyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="NexusElevatedCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NavyElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NavyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Primary Accent Button -->
  <Style x:Key="NexusPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BlueAccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource CyanSoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BluePressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary Outline Button -->
  <Style x:Key="NexusSecondaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource NavyElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NavyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rounded TextBox -->
  <Style x:Key="NexusTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource NavyDeepestBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource CyanAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NavyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Typography -->
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="LabelMutedStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Danger Button -->
  <Style x:Key="NexusDangerButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="#3B1219" />
    <Setter Property="Foreground" Value="#FCA5A5" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

