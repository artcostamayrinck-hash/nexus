<Application x:Class="Nexus.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexus.Desktop.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/NexusTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:SectionVisibilityConverter x:Key="SectionVisibilityConverter" />
      <conv:SectionEqualsConverter x:Key="SectionEqualsConverter" />
      <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
      <conv:BytesToImageConverter x:Key="BytesToImageConverter" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <conv:PairingStateToBrushConverter x:Key="PairingStateToBrushConverter" />
      <conv:TrustStatusToBrushConverter x:Key="TrustStatusToBrushConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>

