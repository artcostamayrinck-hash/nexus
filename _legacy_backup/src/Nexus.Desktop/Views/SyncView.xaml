<UserControl x:Class="Nexus.Desktop.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Sincronização Básica (Clipboard &amp; Notas)" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Área de transferência compartilhada, notas versionadas, fila offline e resolução transparente de conflitos."
                     Style="{StaticResource PageSubtitleStyle}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Content="Sincronizar Agora"
                Command="{Binding SyncNowCommand}"
                Style="{StaticResource NexusPrimaryButtonStyle}"
                VerticalAlignment="Center" />
      </DockPanel>

      <!-- KPI Strip -->
      <UniformGrid Columns="4" Margin="0,0,0,14">
        <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="ESTADO SYNC" Style="{StaticResource LabelMutedStyle}" />
            <TextBlock Text="{Binding SyncStatusText}" Foreground="{StaticResource CyanAccentBrush}" FontSize="19" FontWeight="Bold" Margin="0,6,0,2" />
            <TextBlock Text="{Binding StatusBanner}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="ÚLTIMA SINCRONIZAÇÃO" Style="{StaticResource LabelMutedStyle}" />
            <TextBlock Text="{Binding LastSyncText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,6,0,2" />
            <TextBlock Text="Indicador local de convergência" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="FILA OFFLINE" Style="{StaticResource LabelMutedStyle}" />
            <TextBlock Text="{Binding PendingQueueText}" Foreground="{StaticResource WarningBrush}" FontSize="17" FontWeight="Bold" Margin="0,6,0,2" />
            <TextBlock Text="Retomada automática ao reconectar" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="CONFLITOS DE NOTAS" Style="{StaticResource LabelMutedStyle}" />
            <TextBlock Text="{Binding ConflictsCountText}" Foreground="{StaticResource DangerBrush}" FontSize="17" FontWeight="Bold" Margin="0,6,0,2" />
            <TextBlock Text="Sem sobrescrita silenciosa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Privacy & Platform Capability Card -->
      <Border Style="{StaticResource NexusCardStyle}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Privacidade, Limites de Histórico e Capacidade do Sistema" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
            <Button Content="Salvar Preferências"
                    Command="{Binding SavePreferencesCommand}"
                    Style="{StaticResource NexusSecondaryButtonStyle}"
                    DockPanel.Dock="Right" />
          </DockPanel>

          <TextBlock Text="{Binding PlatformCapabilityText}"
                     Foreground="{StaticResource CyanAccentBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10" />

          <WrapPanel Orientation="Horizontal">
            <CheckBox Content="Sincronizar Clipboard"
                      IsChecked="{Binding ClipboardSyncEnabled}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,18,6" />
            <CheckBox Content="Auto-sync Clipboard"
                      IsChecked="{Binding ClipboardAutoSync}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,18,6" />
            <CheckBox Content="Sincronizar Notas"
                      IsChecked="{Binding NotesSyncEnabled}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,18,6" />
            <CheckBox Content="Auto-sync Notas"
                      IsChecked="{Binding NotesAutoSync}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,18,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
              <TextBlock Text="Histórico máx:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding ClipboardMaxHistoryItems, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource NexusTextBoxStyle}"
                       Width="58" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="Política de conflito:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox ItemsSource="{Binding AvailablePolicies}"
                        SelectedItem="{Binding SelectedConflictPolicy}"
                        Width="140" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Main Split: Clipboard & Notes -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: NEXUS Clipboard -->
        <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <TextBlock Text="NEXUS Clipboard" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8" />
            <TextBox Text="{Binding ClipboardInputText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource NexusTextBoxStyle}"
                     AcceptsReturn="True"
                     Height="64"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,10">
              <Button Content="Enviar Texto"
                      Command="{Binding SendClipboardTextCommand}"
                      Style="{StaticResource NexusPrimaryButtonStyle}"
                      Margin="0,0,8,6" />
              <Button Content="Capturar do Windows"
                      Command="{Binding CaptureOsClipboardCommand}"
                      Style="{StaticResource NexusSecondaryButtonStyle}"
                      Margin="0,0,8,6" />
              <Button Content="Limpar"
                      Command="{Binding ClearClipboardHistoryCommand}"
                      Style="{StaticResource NexusDangerButtonStyle}"
                      Margin="0,0,0,6" />
            </WrapPanel>

            <TextBlock Text="HISTÓRICO RECENTE" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding ClipboardHistory}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="300">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,0,0,8" Padding="10">
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              Content="Copiar"
                              Command="{Binding DataContext.CopyHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource NexusSecondaryButtonStyle}"
                              Padding="10,5"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                      <StackPanel>
                        <TextBlock Text="{Binding ContentText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="60"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0">
                          <Run Text="{Binding OriginDeviceName, Mode=OneWay}" />
                          <Run Text=" · " />
                          <Run Text="{Binding CapturedAtUtc, StringFormat='{}{0:dd/MM HH:mm:ss}', Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <!-- Right Column: NEXUS Notes -->
        <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="NEXUS Notes" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
              <WrapPanel DockPanel.Dock="Right">
                <Button Content="Nova Nota"
                        Command="{Binding NewNoteCommand}"
                        Style="{StaticResource NexusSecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Salvar Nota"
                        Command="{Binding SaveNoteCommand}"
                        Style="{StaticResource NexusPrimaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Excluir"
                        Command="{Binding DeleteSelectedNoteCommand}"
                        Style="{StaticResource NexusDangerButtonStyle}" />
              </WrapPanel>
            </DockPanel>

            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource NexusTextBoxStyle}"
                     Tag="Pesquisar notas..."
                     Margin="0,0,0,10" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
              </Grid.ColumnDefinitions>

              <ListBox Grid.Column="0"
                       ItemsSource="{Binding Notes}"
                       SelectedItem="{Binding SelectedNote}"
                       Background="Transparent"
                       BorderThickness="0"
                       MaxHeight="250">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,0,0,6" Padding="10">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                          <Run Text="v" />
                          <Run Text="{Binding Version, Mode=OneWay}" />
                          <Run Text=" · " />
                          <Run Text="{Binding ModifiedAtUtc, StringFormat='{}{0:dd/MM HH:mm}', Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding EditorMetadataText}" Foreground="{StaticResource CyanAccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NexusTextBoxStyle}"
                         Margin="0,0,0,8" />
                <TextBox Text="{Binding EditorBody, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NexusTextBoxStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="140" />
              </StackPanel>
            </Grid>

            <!-- Revision History -->
            <TextBlock Text="HISTÓRICO DE VERSÕES DA NOTA SELECIONADA" Style="{StaticResource LabelMutedStyle}" Margin="0,12,0,6" />
            <ListBox ItemsSource="{Binding SelectedNoteRevisions}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="130">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right"
                            Content="Restaurar"
                            Command="{Binding DataContext.RestoreRevisionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource NexusSecondaryButtonStyle}"
                            Padding="8,4" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center">
                      <Run Text="v" />
                      <Run Text="{Binding Version, Mode=OneWay}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Title, Mode=OneWay}" />
                      <Run Text=" (" />
                      <Run Text="{Binding Reason, Mode=OneWay}" />
                      <Run Text=" por " />
                      <Run Text="{Binding ModifiedByDeviceName, Mode=OneWay}" />
                      <Run Text=")" />
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Conflict Resolution Card -->
      <Border Style="{StaticResource NexusCardStyle}">
        <StackPanel>
          <TextBlock Text="Resolução de Conflitos (Preservação de Ambas as Versões)" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0.7*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding UnresolvedConflicts}"
                     SelectedItem="{Binding SelectedConflict}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="150">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,0,0,6" Padding="8">
                    <StackPanel>
                      <TextBlock Text="{Binding LocalTitle}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                      <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Local v" />
                        <Run Text="{Binding LocalVersion, Mode=OneWay}" />
                        <Run Text=" vs Remoto v" />
                        <Run Text="{Binding RemoteVersion, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="2">
              <TextBlock Text="Título mesclado (para Merge Manual):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
              <TextBox Text="{Binding ConflictMergedTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" Margin="0,4,0,6" />
              <TextBlock Text="Conteúdo mesclado:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
              <TextBox Text="{Binding ConflictMergedBody, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NexusTextBoxStyle}" AcceptsReturn="True" Height="74" TextWrapping="Wrap" Margin="0,4,0,8" />
              <WrapPanel>
                <Button Content="Manter Local" Command="{Binding KeepLocalConflictCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Aceitar Remota" Command="{Binding AcceptRemoteConflictCommand}" Style="{StaticResource NexusSecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Salvar Merge Manual" Command="{Binding ManualMergeConflictCommand}" Style="{StaticResource NexusPrimaryButtonStyle}" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

