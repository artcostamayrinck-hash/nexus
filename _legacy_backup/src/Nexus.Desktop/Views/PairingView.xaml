<UserControl x:Class="Nexus.Desktop.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <!-- Header -->
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Pareamento Seguro por QR Code" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Estabeleça confiança criptográfica ECDSA P-256 + TLS entre este Windows e seu dispositivo Android."
                     Style="{StaticResource PageSubtitleStyle}"
                     Margin="0,4,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{StaticResource NavyElevatedBrush}"
                BorderBrush="{Binding CurrentState, Converter={StaticResource PairingStateToBrushConverter}}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,7">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9"
                     Fill="{Binding CurrentState, Converter={StaticResource PairingStateToBrushConverter}}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StateLabel}"
                       Foreground="{Binding CurrentState, Converter={StaticResource PairingStateToBrushConverter}}"
                       FontWeight="SemiBold"
                       FontSize="13" />
          </StackPanel>
        </Border>
      </DockPanel>

      <!-- Main Two-Column Grid -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Local Crypto Identity + Temporary QR Code -->
        <Border Grid.Column="0" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="1. QR Code Temporário do Windows" Style="{StaticResource CardHeaderStyle}" DockPanel.Dock="Left" />
              <TextBlock Text="{Binding CountdownText}"
                         Foreground="{StaticResource CyanAccentBrush}"
                         FontWeight="SemiBold"
                         FontSize="12"
                         HorizontalAlignment="Right"
                         DockPanel.Dock="Right" />
            </DockPanel>

            <!-- Host Cryptographic Identity Box -->
            <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{Binding LocalDeviceName}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ModeBadge}"
                             Foreground="{StaticResource CyanAccentBrush}"
                             FontSize="11"
                             HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="{Binding LocalDeviceIdText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Margin="0,3,0,0" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0">
                  <Run Text="Chave ECDSA: " />
                  <Run Text="{Binding LocalFingerprintDisplay, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource CyanAccentBrush}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Button Content="Gerar QR Code"
                      AutomationProperties.Name="Gerar Novo QR Code de Pareamento"
                      Command="{Binding GenerateQrCommand}"
                      Style="{StaticResource NexusPrimaryButtonStyle}"
                      Margin="0,0,10,0" />
              <Button Content="Verificar Status"
                      AutomationProperties.Name="Verificar Status do Pareamento"
                      Command="{Binding PollStatusCommand}"
                      Style="{StaticResource NexusSecondaryButtonStyle}"
                      Margin="0,0,10,0" />
              <Button Content="Reiniciar"
                      AutomationProperties.Name="Reiniciar Pareamento"
                      Command="{Binding ResetPairingCommand}"
                      Style="{StaticResource NexusSecondaryButtonStyle}" />
            </StackPanel>

            <!-- QR Image Presentation (White Quiet Zone for reliable Android scanning) -->
            <Border Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    Padding="14"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
              <Image Source="{Binding QrPngBytes, Converter={StaticResource BytesToImageConverter}}"
                     Width="230"
                     Height="230"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     AutomationProperties.Name="Imagem do QR Code de Pareamento" />
            </Border>

            <Border Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource NexusElevatedCardStyle}"
                    Margin="0,0,0,10">
              <DockPanel>
                <Button Content="Copiar Payload"
                        AutomationProperties.Name="Copiar Payload JSON do QR Code"
                        Click="OnCopyQrPayloadClick"
                        Style="{StaticResource NexusSecondaryButtonStyle}"
                        Padding="10,6"
                        DockPanel.Dock="Right" />
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="Payload Assinado (uso único / anti-repetição)"
                             Style="{StaticResource LabelMutedStyle}" />
                  <TextBox Text="{Binding QrPayloadJson, Mode=OneWay}"
                           IsReadOnly="True"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Consolas"
                           FontSize="10" />
                </StackPanel>
              </DockPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource CyanAccentBrush}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Right: Android Validation, SAS Verification Code & Trust Approval -->
        <Border Grid.Column="2" Style="{StaticResource NexusCardStyle}">
          <StackPanel>
            <TextBlock Text="2. Validação e Confirmação Mútua" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,12" />

            <!-- Short Authentication String (6-digit SAS code) -->
            <Border Background="{StaticResource NavyDeepestBrush}"
                    BorderBrush="{Binding CurrentState, Converter={StaticResource PairingStateToBrushConverter}}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,14">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="CÓDIGO DE VERIFICAÇÃO MÚTUA"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding VerificationCode}"
                           Foreground="{StaticResource CyanAccentBrush}"
                           FontSize="30"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
                <TextBlock Text="Confirme que este código é idêntico no Android antes de aprovar."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <!-- Candidate Device Info -->
            <Border Style="{StaticResource NexusElevatedCardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Dispositivo Solicitante" Style="{StaticResource LabelMutedStyle}" />
                <TextBlock Text="{Binding CandidateDeviceName}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding CandidateDetail}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0">
                  <Run Text="Impressão Digital: " />
                  <Run Text="{Binding CandidateFingerprintDisplay, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <!-- Granted Permissions -->
            <TextBlock Text="Permissões Concedidas ao Dispositivo" Style="{StaticResource LabelMutedStyle}" Margin="0,0,0,8" />
            <UniformGrid Columns="2" Margin="0,0,0,16">
              <CheckBox Content="Status &amp; Saúde" IsChecked="{Binding AllowViewStatus}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
              <CheckBox Content="Notificações" IsChecked="{Binding AllowNotifications}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
              <CheckBox Content="Área de Transf." IsChecked="{Binding AllowClipboard}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
              <CheckBox Content="Transferência" IsChecked="{Binding AllowFileTransfer}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
              <CheckBox Content="Controle Remoto" IsChecked="{Binding AllowRemoteCommands}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
              <CheckBox Content="Gerenciar Disp." IsChecked="{Binding AllowManageDevices}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
            </UniformGrid>

            <!-- Approve / Reject Controls -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0"
                      Content="Aprovar Pareamento"
                      AutomationProperties.Name="Aprovar Pareamento do Dispositivo"
                      Command="{Binding ApprovePairingCommand}"
                      Style="{StaticResource NexusPrimaryButtonStyle}" />
              <Button Grid.Column="2"
                      Content="Rejeitar"
                      AutomationProperties.Name="Rejeitar Pareamento do Dispositivo"
                      Command="{Binding RejectPairingCommand}"
                      Style="{StaticResource NexusDangerButtonStyle}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
